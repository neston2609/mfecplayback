NODE_ENV=development
PORT=4178
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-48-characters
# 32-byte key, base64 encoded. Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=
DATABASE_PATH=./runtime/recording-explorer.sqlite
MOCK_MODE=true
# Required to bootstrap the first user in production. Use a long unique password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeThisToALongUniquePassword!
SESSION_MAX_AGE_HOURS=8
